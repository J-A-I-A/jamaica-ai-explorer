# Copy to .env.local and fill in. Every value here is read from the environment
# at runtime — nothing is baked into the build — so one image can be promoted
# across environments unchanged. In development the code degrades rather than
# crashes when a value is absent; in production a missing RECAPTCHA_SECRET_KEY
# or POSTGRES_URL makes /api/feedback refuse submissions.

# --- Assistant (/api/chat) --------------------------------------------------
MODEL_API_KEY=
OPENAI_BASE_URL=
MODEL=
# MODEL_MAX_TOKENS=4096
# Questions answered per address per rolling window. 0 disables the limit.
# CHAT_RATE_LIMIT=15
# CHAT_RATE_WINDOW_HOURS=24

# --- Privacy policy source (/privacy) ---------------------------------------
# The page renders a Google Doc written in Markdown. Share the doc as
# "Anyone with the link -> Viewer", then paste its URL below exactly as it
# appears in the browser's address bar. Start from
# docs/privacy-policy-template.md. Unset, /privacy says the policy has not been
# published yet.
PRIVACY_DOC_URL=https://docs.google.com/document/d/1xFKd-0cYJXSs8BRXfG9B6p_DsaQ7wmMfu-bEdlu3A-Y/edit?usp=sharing
# How long a fetched copy is served before Google is asked again.
# PRIVACY_DOC_CACHE_SECONDS=300

# --- Assistant privacy notice (/assistant) ----------------------------------
# The short line under the chat composer. Name whoever actually receives the
# questions — if you point OPENAI_BASE_URL at a different provider, change this
# too, or the page tells the public something untrue.
# ASSISTANT_DATA_PROCESSOR=Microsoft
# Replaces the whole sentence; wins over ASSISTANT_DATA_PROCESSOR above.
# ASSISTANT_PRIVACY_NOTICE=

# --- Feedback master switch (/feedback, /api/feedback) ----------------------
# Whether the consultation is accepting submissions. While this is false the
# form still renders so people can read what will be asked, but the submit
# button is disabled, no reCAPTCHA is shown, and the API rejects posts with 503.
# Accepts true/false (also 1/0, yes/no, on/off, open/closed).
# UNSET MEANS CLOSED — a fresh environment never opens a consultation by
# accident, so this has to be set deliberately to start collecting feedback.
FEEDBACK_SUBMISSIONS_OPEN=false

# --- reCAPTCHA v2 (/api/feedback) -------------------------------------------
# Both are read at runtime, so the same built image works in any environment.
# The site key reaches the browser as a prop rendered by /feedback, not as a
# NEXT_PUBLIC_* value baked into the client bundle at build time.
# Set both together: without the site key the checkbox never renders, and in
# production a missing secret makes the API refuse submissions outright rather
# than accept them unverified.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Submission rate limit (/api/feedback) ----------------------------------
# Submissions accepted per address per rolling window, held in memory per app
# instance. Kept generous because an office, campus or ISP can share one
# address; reCAPTCHA is the check that stops bots. 0 disables the limit.
# FEEDBACK_RATE_LIMIT=10
# FEEDBACK_RATE_WINDOW_HOURS=1

# --- Postgres: system of record for feedback submissions --------------------
# URL may carry the credentials inline; when it does, leave USER/PASSWORD
# blank. When both are set, USER/PASSWORD win over anything in the URL.
POSTGRES_URL=postgres://db-host.example.com:5432/jaia
POSTGRES_USER=
POSTGRES_PASSWORD=
# TLS: disable | no-verify | verify-full. Defaults to no-verify for a remote
# host and disable for localhost.
# POSTGRES_SSL=
# POSTGRES_POOL_MAX=3
