# Copy to .env and fill in. Names mirror the Next.js app so you can reuse values.

# The chat-completions base, WITHOUT the trailing /chat/completions.
# Azure Foundry surfaces differ — copy the URL from the deployment's own
# "Endpoint" panel in the portal, not from the project overview:
#   https://<resource>.services.ai.azure.com/openai/v1
#   https://<resource>.openai.azure.com/openai/v1
#   https://<deployment>.<region>.models.ai.azure.com/v1
# Not sure which? Run: python scripts/diagnose_auth.py
OPENAI_BASE_URL=

# Your deployment name, e.g. DeepSeek-V4-Flash
MODEL=

# The key from that same deployment page. A key from a different resource, or
# a project-level key, produces a 401 that reads like a wrong-endpoint error.
MODEL_API_KEY=

# How to send the key: auto | api-key | bearer | subscription-key
# `auto` sends `api-key` to *.azure.com hosts and `Authorization: Bearer`
# elsewhere, then retries the alternatives once if it gets a 401.
AUTH_STYLE=auto

# Only if your endpoint requires an explicit api-version query parameter.
# Leave blank for the /openai/v1 surface.
OPENAI_API_VERSION=

# Tokens-per-minute quota on this deployment. The suite paces itself to stay
# under it rather than tripping 429 RateLimitReached. Raise this after a quota
# increase; set 0 to disable pacing (local model, no quota).
TPM_LIMIT=20000

