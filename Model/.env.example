# Copy to .env and adjust. Docker Compose reads .env from this folder automatically.

# Required before exposing the service: clients must send "Authorization: Bearer <key>".
API_KEY=change-me-to-a-long-random-string

# 127.0.0.1 keeps the API reachable only from this host (e.g. behind a reverse proxy).
# Use 0.0.0.0 to listen on all interfaces.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Pin the server image to the digest you tested.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:559ac229adefe0f7e2d4e32f5222f26927b6bb8ba44b9db08e2544afebf41984

# Leave at 0 for the first start so the model can download, then set to 1.
OFFLINE=0

# Capacity. Each request must fit in CTX_SIZE / PARALLEL tokens.
PARALLEL=4
CTX_SIZE=32768
THREADS=6
